@startuml
skinparam classAttributeIconSize 0
title Eternal Quest Program - Updated UML Design

class Program {
  + Main() : void
  - ShowMenu(manager : GoalManager) : void
  - CreateGoalMenu(manager : GoalManager) : void
  - RecordEventMenu(manager : GoalManager) : void
}

abstract class Goal {
  - _name : string
  - _description : string
  - _points : int
  + Goal(name : string, description : string, points : int)
  + GetName() : string
  + GetDescription() : string
  + GetPoints() : int
  + abstract RecordEvent() : int
  + abstract IsComplete() : bool
  + abstract GetDetailsString() : string
  + abstract ToGoalData() : GoalData
}

class SimpleGoal {
  - _isComplete : bool
  + SimpleGoal(name : string, description : string, points : int, isComplete : bool = false)
  + override RecordEvent() : int
  + override IsComplete() : bool
  + override GetDetailsString() : string
  + override ToGoalData() : GoalData
}

class EternalGoal {
  + EternalGoal(name : string, description : string, points : int)
  + override RecordEvent() : int
  + override IsComplete() : bool
  + override GetDetailsString() : string
  + override ToGoalData() : GoalData
}

class ChecklistGoal {
  # _amountCompleted : int
  # _targetAmount : int
  # _bonus : int
  + ChecklistGoal(name : string, description : string, points : int, targetAmount : int, bonus : int, amountCompleted : int = 0)
  + override RecordEvent() : int
  + override IsComplete() : bool
  + override GetDetailsString() : string
  + override ToGoalData() : GoalData
}

class GoalManager {
  - _goals : List~Goal~
  - _score : int
  + GoalManager()
  + AddGoal(goal : Goal) : void
  + GetGoals() : List~Goal~
  + GetScore() : int
  + GetLevel() : int
  + GetPointsToNextLevel() : int
  + DisplayPlayerInfo() : void
  + ListGoalDetails() : void
  + RecordEvent(goalIndex : int) : int
  + SetData(score : int, goals : List~Goal~) : void
  + SaveGoals(filename : string) : void
  + LoadGoals(filename : string) : void
}

class GoalFileHandler {
  + Save(filename : string, score : int, goals : List~Goal~) : void
  + Load(filename : string) : SaveData
  - CreateGoalFromData(data : GoalData) : Goal
}

class SaveData {
  + Score : int
  + Goals : List~GoalData~
}

class GoalData {
  + Type : string
  + Name : string
  + Description : string
  + Points : int
  + IsComplete : bool
  + AmountCompleted : int
  + TargetAmount : int
  + Bonus : int
}

Goal <|-- SimpleGoal
Goal <|-- EternalGoal
Goal <|-- ChecklistGoal

GoalManager o-- Goal
GoalManager --> GoalFileHandler
GoalFileHandler --> SaveData
GoalFileHandler --> GoalData
Goal --> GoalData
Program --> GoalManager

@enduml